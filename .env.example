# Copy to .env for local runs (never commit .env). In GitHub Actions,
# set these under Settings -> Secrets and variables -> Actions.

# --- Secrets ---
OUTREACH_SMTP_HOST=smtp.example.com
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_USER=outreach@acmesupply.example
OUTREACH_SMTP_PASS=your-mailbox-password
OUTREACH_IMAP_HOST=imap.example.com
OUTREACH_FROM_EMAIL=outreach@acmesupply.example

# Owner mailbox for the run summary
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_NOTIFY=you@example.com

# --- Configuration (optional) ---
SENDER_NAME=Alex Morgan
# Comma-separated outreach logs. Relative paths resolve against STATE_DIR.
OUTREACH_LOG_FILES=outreach-log.json
FOLLOWUP_1_DAYS=4
FOLLOWUP_2_DAYS=10
COLD_DAYS=18
MAX_SENDS_PER_RUN=10
# SUPPRESSION_FILE=../ai-reply-triage/state/suppression-list.json
# CONFIG_DIR=./config
# STATE_DIR=./state
